{
  "name": "yachexp",
  "private": true,
  "version": "0.0.0",
  "description": "Local tooling for dependency pinning and vendoring.",
  "scripts": {
    "build:source-review": "powershell -ExecutionPolicy Bypass -File scripts\\source-package.ps1",
    "build:xpi": "powershell -ExecutionPolicy Bypass -File scripts\\package.ps1",
    "deps:sync": "powershell -ExecutionPolicy Bypass -File scripts\\copy-deps.ps1",
    "sign:unlisted": "powershell -ExecutionPolicy Bypass -File scripts\\release.ps1",
    "test": "node --test"
  },
  "devDependencies": {
    "jsonata": "2.1.0",
    "turndown": "7.1.2",
    "turndown-plugin-gfm": "1.0.2",
    "yuppee": "1.0.0"
  }
}
